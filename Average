"""
WAP to check average among three no. and find average range among input value.
"""
num1 = float(input("Enter first number: "))
num2 = float(input("Enter second number: "))
num3 = float(input("Enter third number: "))
average = (num1 + num2 + num3) / 3
print(f"The average of the three numbers is: ", average)
if average < 50:
    print("The average is less than 50.")
elif average < 75:
    print("The average is between 50 and 75.")
else:
    print("The average is greater than or equal to 75.")
