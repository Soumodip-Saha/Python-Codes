## Write a program to multiply two matrices using list in python
print("--- Matrix 1 ---")
rows1 = int(input("Enter number of rows for Matrix 1: "))
cols1 = int(input("Enter number of columns for Matrix 1: "))
matrix1 = []
print("Enter the numbers for Matrix 1:")
for i in range(rows1):
    row = [] 
    for j in range(cols1):
        number = int(input(f"Row {i+1}, Column {j+1}: "))
        row.append(number)
    matrix1.append(row)
print("\n--- Matrix 2 ---")
rows2 = int(input("Enter number of rows for Matrix 2: "))
cols2 = int(input("Enter number of columns for Matrix 2: "))
matrix2 = []
print("Enter the numbers for Matrix 2:")
for i in range(rows2):
    row = []
    for j in range(cols2):
        number = int(input(f"Row {i+1}, Column {j+1}: "))
        row.append(number)
    matrix2.append(row)
if cols1 != rows2:
    print("\nError: Cannot multiply these matrices!")
    print("The number of columns in Matrix 1 must equal the number of rows in Matrix 2.")
else:
    result = []
    for i in range(rows1):
        row = []
        for j in range(cols2):
            row.append(0)
        result.append(row)
    for i in range(rows1):
        for j in range(cols2):
            for k in range(rows2):
                result[i][j] += matrix1[i][k] * matrix2[k][j]
    print("\n--- Result of Matrix Multiplication ---")
    for row in result:
        print(row)
