"""
Write a Program in Python for determining whether a number is a Perfect number or not.
(e.g. 28 is a Perfect Number because Sum of the Divisor of 28 = 1+2+4+7+14 =28.)
"""
num = int(input("Enter a number : "))
if num < 0:
    print("Perfect number of negative number is not possible !!!!")
else:
    sum_of_divisors = 0
    for i in range(1, num):
        if num % i == 0:
            sum_of_divisors += i
    if sum_of_divisors == num:
        print(num, "is a Perfect Number.")
    else:
        print(num, "is not a Perfect Number.")
