"""
Write a Program in Python to compute the Factorial of a Number.
"""
num = int(input("Enter a number : "))
factorial = 1
if num<0 :
    print("Factorial of negative number not podssiblr !!!!" )
else:
    for i in range(1,num+1):
        factorial*=i
    print("The factorial of",num,"is",factorial)         
